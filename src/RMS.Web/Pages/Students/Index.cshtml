@page
@model RMS.Web.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Student</a>
</p>

<form method="get">
    <div class="form-group row">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search students..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">Search</button>
            <a asp-page="./Index" class="btn btn-link">Clear</a>
        </div>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Program</th>
            <th>Level</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model.Students)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.Email</td>
                <td>@student.Program</td>
                <td>@student.Level</td>
                <td>
                    <a asp-page="./Details" asp-route-id="@student.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="./Edit" asp-route-id="@student.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Students.Any())
{
    <p class="text-muted">No students found.</p>
}
